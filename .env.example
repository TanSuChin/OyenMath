# Copy to .env. Supports EITHER Groq (GROQ_API_KEY) OR Anthropic (ANTHROPIC_API_KEY)!
# Without an API key, the 12-node Autonomous LangGraph & /api/agent run in deterministic rule-based fallback mode.

# Option 1: Groq API Key (e.g. gsk_...) — uses llama-3.3-70b-versatile + tool-calling & Llama-4 Scout Vision OCR
GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Anthropic API Key (e.g. sk-ant-...)
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: Live Firebase Cloud Authentication & Ownership Enforcement
# When FIREBASE_PROJECT_ID is set (or js/firebase-config.js is non-null), the server requires a valid
# Authorization: Bearer <Firebase ID Token> header and derives student_id from the verified token.
# Without it, the server runs in clearly-labelled Offline Dev Mode (student_id="dev-local" or X-Oyen-Dev-Student).
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Custom directory for local atomic mission checkpoints (default: .oyen_data)
# OYEN_DATA_DIR=.oyen_data
